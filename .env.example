# ============================================================================
# Firstsource RFP Response Generator - environment configuration
# Copy to .env and fill in. NEVER commit the real .env to version control.
# ============================================================================

# ---------------------------------------------------------------- REQUIRED
# Azure OpenAI credentials. Read from the environment at runtime; never sent to
# the browser. On a real server prefer injecting these from your secret store
# (Azure Key Vault) rather than a .env file on disk.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# API version - use the latest stable version available in your region.
AZURE_OPENAI_API_VERSION=2024-02-01
# The name of your deployed model (e.g. gpt-4o, gpt-4, gpt-35-turbo).
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ------------------------------------------------------------------- MODEL
AZURE_OPENAI_MAX_TOKENS=16000
AZURE_OPENAI_TIMEOUT_SECONDS=300

# --------------------------------------------------------------------- APP
ENVIRONMENT=local                       # local | staging | production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Public URL users type in. Must be exact - the OIDC redirect URI is built from it.
# Local:  http://localhost:8000
# Server: https://rfp.yourcompany.com
PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------ LIMITS
MAX_FILES=20
MAX_UPLOAD_MB=25
MAX_CHARS_PER_DOCUMENT=60000
MAX_TOTAL_CORPUS_CHARS=140000
MAX_PROMPT_CORPUS_CHARS=48000
MAX_KNOWLEDGE_CHARS_PER_FILE=60000

# -------------------------------------------------------------------- AUTH
# disabled -> no login (ONLY acceptable on a strictly internal/VPN-only host)
# oidc     -> Azure AD / Entra ID / any OpenID Connect provider
AUTH_MODE=disabled

# Signs the session cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=fs_rfp_session
SESSION_MAX_AGE_SECONDS=28800
# Set true once the app is served over HTTPS (required in production).
SESSION_HTTPS_ONLY=false

# --- OIDC / Azure AD (only needed when AUTH_MODE=oidc) ---------------------
# Azure AD discovery URL - replace <TENANT_ID>:
#   https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Optional comma-separated allow-list. Empty = anyone your IdP authenticates.
OIDC_ALLOWED_EMAIL_DOMAINS=firstsource.com

# ---------------------------------------------------------- RAG (Phase 1) ---
# Off by default. Set to true once Qdrant + an embedding deployment are ready.
RAG_ENABLED=false
# "local" reads knowledge/rag_sample_docs for testing without SharePoint access.
# "sharepoint" reads from Microsoft Graph (requires the MS_* and SHAREPOINT_* values).
RAG_SOURCE=local
RAG_LOCAL_SOURCE_DIR=knowledge/rag_sample_docs

# Microsoft Graph app-only auth (Entra app registration, Sites.Selected permission)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://firstsourcenew.sharepoint.com/sites/IntelligentAutomationCoE
SHAREPOINT_LIBRARY=Demos
SHAREPOINT_FOLDER=GenAI Content/relAI/relAI Latest Pitch Deck/Analyst

# Azure OpenAI embeddings credentials and deployment (separate from the chat model above)
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01

# Qdrant vector database (self-hosted, e.g. Docker on your Azure VM)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# QDRANT_COLLECTION=firstsource_analyst_kb

# ---------------------------------------------------------- RAG (Phase 4) ---
# Multi-vector schema (dense_content/dense_summary/dense_metadata/dense_table +
# sparse_bm25) lives in a SEPARATE collection - run `python -m app.rag.ingest`
# to (re)populate it after changing this.
QDRANT_COLLECTION_V2=firstsource_analyst_kb_v2
RAG_TABLE_CHUNK_THRESHOLD=0.4

# Semantic cache: caches retrieval results by query-embedding similarity in a
# separate small Qdrant collection. Off by default.
RAG_CACHE_ENABLED=false
QDRANT_CACHE_COLLECTION=rag_semantic_cache
RAG_CACHE_SIMILARITY_THRESHOLD=0.95
RAG_CACHE_TTL_HOURS=168

# Chunking + retrieval tuning (sane defaults, rarely need changing)
RAG_CHUNK_TOKENS=200
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_RETRIEVE_TOP_K=100
RAG_RERANK_TOP_K=8
# Reranker scores are raw unbounded logits - drop chunks trailing this far behind
# the best match for a query, in addition to the top_k cap.
RAG_RERANK_SCORE_MARGIN=6.0

# ---------------------------------------------------------- RAG (Phase 2) ---
# Postgres metadata (documents/ingestion history) + DeepEval scorecards.
# Off by default; failures here never block ingestion or generation.
PG_ENABLED=false
PG_HOST=
PG_PORT=5432
# A dedicated database for this project - do not point this at a database
# shared with another project.
PG_DBNAME=
PG_SCHEMA=public
PG_USER=
PG_PASSWORD=
# "require" for any public/internet-reachable Postgres (e.g. AWS RDS public endpoint).
PG_SSLMODE=require

# ---------------------------------------------------------- RAG (Phase 3) ---
# Images, charts, diagrams and scanned pages described via the existing gpt-5.4
# vision-capable chat deployment - no separate OCR engine, no GPU.
RAG_VISION_ENABLED=true
# Skip tiny decorative images (icons, bullets, logos).
RAG_VISION_MIN_IMAGE_PX=80
# Pages with less extracted text than this are treated as likely-scanned and
# rendered to an image for vision description instead.
RAG_VISION_MIN_PAGE_CHARS=30

# -------------------------------------------------------------------- MISC
# Only needed if the frontend is served from a different origin than the API.
CORS_ALLOW_ORIGINS=
# Base64-embed the brand fonts into downloaded HTML so it stays on-brand offline.
EMBED_FONTS_IN_HTML=true

# ---------------------------------------------------------- SharePoint sync
# Background polling that keeps the vector index fresh. One Microsoft Graph
# delta query both walks the whole nested folder tree and reports incremental
# changes, so new files, edits and deletions are all picked up automatically.
#
# With RAG_SOURCE=sharepoint this REQUIRES PG_ENABLED=true - the delta link and
# per-document state have nowhere else to live.
#
# On Azure App Service, enable "Always On", or the app unloads when idle and
# stops polling.
RAG_SYNC_ENABLED=false
RAG_SYNC_INTERVAL_MINUTES=15
# Periodic full re-enumeration: catches anything a delta missed and retries
# previously-failed documents. Microsoft recommends no more than once a day.
RAG_SYNC_FULL_RECONCILE_HOURS=24
# Give up on a document after this many consecutive ingestion failures. It is
# retried again only if its content changes.
RAG_SYNC_MAX_ATTEMPTS=3
# SharePoint accumulates "file (1).pdf" copies. Index identical content once so
# the retriever cannot see the same evidence twice.
RAG_SKIP_DUPLICATE_CONTENT=true
