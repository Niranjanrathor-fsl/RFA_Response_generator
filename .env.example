# ============================================================================
# Firstsource RFP Response Generator - environment configuration
# Copy to .env and fill in. NEVER commit the real .env to version control.
# ============================================================================

# ---------------------------------------------------------------- REQUIRED
# Azure OpenAI credentials. Read from the environment at runtime; never sent to
# the browser. On a real server prefer injecting these from your secret store
# (Azure Key Vault) rather than a .env file on disk.
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# API version - use the latest stable version available in your region.
AZURE_OPENAI_API_VERSION=2024-02-01
# The name of your deployed model (e.g. gpt-4o, gpt-4, gpt-35-turbo).
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ------------------------------------------------------------------- MODEL
AZURE_OPENAI_MAX_TOKENS=16000
AZURE_OPENAI_TIMEOUT_SECONDS=300

# --------------------------------------------------------------------- APP
ENVIRONMENT=local                       # local | staging | production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Public URL users type in. Must be exact - the OIDC redirect URI is built from it.
# Local:  http://localhost:8000
# Server: https://rfp.yourcompany.com
PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------ LIMITS
MAX_FILES=20
MAX_UPLOAD_MB=25
MAX_CHARS_PER_DOCUMENT=60000
MAX_TOTAL_CORPUS_CHARS=140000
MAX_PROMPT_CORPUS_CHARS=48000
MAX_KNOWLEDGE_CHARS_PER_FILE=60000

# -------------------------------------------------------------------- AUTH
# disabled -> no login (ONLY acceptable on a strictly internal/VPN-only host)
# oidc     -> Azure AD / Entra ID / any OpenID Connect provider
AUTH_MODE=disabled

# Signs the session cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=fs_rfp_session
SESSION_MAX_AGE_SECONDS=28800
# Set true once the app is served over HTTPS (required in production).
SESSION_HTTPS_ONLY=false

# --- OIDC / Azure AD (only needed when AUTH_MODE=oidc) ---------------------
# Azure AD discovery URL - replace <TENANT_ID>:
#   https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Optional comma-separated allow-list. Empty = anyone your IdP authenticates.
OIDC_ALLOWED_EMAIL_DOMAINS=firstsource.com

# -------------------------------------------------------------------- MISC
# Only needed if the frontend is served from a different origin than the API.
CORS_ALLOW_ORIGINS=
# Base64-embed the brand fonts into downloaded HTML so it stays on-brand offline.
EMBED_FONTS_IN_HTML=true
