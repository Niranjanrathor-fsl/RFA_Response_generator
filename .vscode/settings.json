{
  "appService.zipIgnorePattern": [
    ".venv{,/**}",
    "venv{,/**}",
    ".git{,/**}",
    ".vscode{,/**}",
    ".github{,/**}",
    "**/__pycache__{,/**}",
    "**/*.pyc",
    ".pytest_cache{,/**}",
    ".ruff_cache{,/**}",
    ".mypy_cache{,/**}",
    "tests{,/**}",
    "docs{,/**}",
    ".env",
    ".env.*",
    "*.log"
  ]
}
